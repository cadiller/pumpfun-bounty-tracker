# Copy this file to .env and fill in real values.

# Port the web server + API listen on
PORT=3000

# Public base URL of your deployment, e.g. https://bounty.yourdomain.com
# Used to build the Telegram Mini App / deep links.
PUBLIC_URL=http://localhost:3000

# Telegram bot token from @BotFather (create with /newbot).
# Leave blank to run the site without Telegram notifications.
TELEGRAM_BOT_TOKEN=
# The bot's @username (without the @), used to build the "Connect Telegram" link.
TELEGRAM_BOT_USERNAME=

# How often to re-check each tracked bounty, in minutes.
POLL_INTERVAL_MINUTES=5

# Shared secret used to sign the simple session cookie. Any random string.
SESSION_SECRET=change-me-to-something-random
